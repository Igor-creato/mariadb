{
  "manifest_version": 3,
  "name": "Кэшбэк Сервис",
  "version": "1.1.0",
  "description": "Получайте кэшбэк с покупок в интернет-магазинах. Автоматическое определение магазинов, активация кэшбэка одним кликом.",
  "default_locale": "ru",
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "activeTab",
    "cookies",
    "webNavigation"
  ],
  "host_permissions": [
    "http://localhost/kash-back/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-gray-16.png",
      "32": "icons/icon-gray-32.png",
      "48": "icons/icon-gray-48.png",
      "128": "icons/icon-gray-128.png"
    },
    "default_title": "Кэшбэк Сервис"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["utils/config.js", "content/content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-gray-16.png",
    "32": "icons/icon-gray-32.png",
    "48": "icons/icon-gray-48.png",
    "128": "icons/icon-gray-128.png"
  },
  "web_accessible_resources": []
}
