# EditorConfig для Cashback Plugin
# https://editorconfig.org

# Top-most EditorConfig file
root = true

# Defaults for all files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# PHP files
[*.php]
indent_style = tab
indent_size = 4

# JavaScript files
[*.js]
indent_style = tab
indent_size = 4

# JSON files
[*.json]
indent_style = space
indent_size = 2

# YAML files
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# Markdown files
[*.md]
trim_trailing_whitespace = false
indent_style = space
indent_size = 2

# SQL files
[*.sql]
indent_style = tab
indent_size = 4

# CSS/SCSS files
[*.{css,scss}]
indent_style = tab
indent_size = 4

# XML/HTML files
[*.{xml,html}]
indent_style = tab
indent_size = 4

# Config files
[{package.json,composer.json}]
indent_style = space
indent_size = 2

# Makefile
[Makefile]
indent_style = tab
