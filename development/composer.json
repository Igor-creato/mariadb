{
    "name": "cashback/cashback-plugin",
    "description": "Cashback and Affiliate Partnership System for WooCommerce",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Cashback Team"
        }
    ],
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "phpstan/phpstan": "^1.10",
        "szepeviktor/phpstan-wordpress": "^1.3",
        "php-stubs/wordpress-stubs": "^6.4",
        "php-stubs/woocommerce-stubs": "^8.0",
        "phpstan/extension-installer": "^1.3",
        "squizlabs/php_codesniffer": "^3.7",
        "wp-coding-standards/wpcs": "^3.0",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "phpstan": "phpstan analyse --configuration=config/phpstan.neon --memory-limit=1G",
        "phpcs": "phpcs --standard=WordPress --extensions=php --ignore=vendor,node_modules ../",
        "phpcbf": "phpcbf --standard=WordPress --extensions=php --ignore=vendor,node_modules ../",
        "lint": [
            "@phpstan",
            "@phpcs"
        ],
        "fix": "@phpcbf"
    },
    "scripts-descriptions": {
        "phpstan": "Run PHPStan static analysis",
        "phpcs": "Check code standards (WordPress Coding Standards)",
        "phpcbf": "Auto-fix code standards violations",
        "lint": "Run all linters (PHPStan + PHPCS)",
        "fix": "Auto-fix code standards violations"
    }
}
